# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.venv/
venv/
env/

# Jupyter
.ipynb_checkpoints/

# Databricks
.databricks/
databricks.yml.bak

# Data (untracked by default; only directory structure is kept)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Exception: source dataset is public (Kaggle, CC0 Public Domain) and small
# enough to commit directly, so the pipeline can be run immediately after
# cloning without a separate download or generation step.
!data/raw/life_insurance_retention_dataset_full.csv
!data/raw/uk_policyholders_source.csv

